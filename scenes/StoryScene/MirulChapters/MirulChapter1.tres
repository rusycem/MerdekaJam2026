"node_name": &"_GraphNode_24277",
"position": [-540.0, 0.0],
"set_flags": "",
"speaker": "",
"text": "The door closes behind her. For one glorious second, the classroom is silent.",
"type": "dialogue"
},
&"_GraphNode_24309": {
"next_node": "_GraphNode_24456",
"node_name": &"_GraphNode_24309",
"position": [-160.0, 20.0],
"set_flags": "",
"speaker": "",
"text": "Then the illusion of order dies. Chairs scrape. Conversations erupt. Someone at the back laughs far too loudly.",
"type": "dialogue"
},
&"_GraphNode_24329": {
"next_node": "_GraphNode_24353",
"node_name": &"_GraphNode_24329",
"position": [600.0, 40.0],
"set_flags": "",
"speaker": "",
"text": "Mirul wastes no time. He drifts over to Vihaan’s desk, leaning in as if whatever they are discussing is suddenly more important than Mathematics.",
"type": "dialogue"
},
&"_GraphNode_24353": {
"next_node": "_GraphNode_26419",
"node_name": &"_GraphNode_24353",
"position": [1000.0, 40.0],
"set_flags": "",
"speaker": "",
"text": "You look away for only a moment.",
"type": "dialogue"
},
&"_GraphNode_24373": {
"next_node": "_GraphNode_26788",
"node_name": &"_GraphNode_24373",
"position": [1740.0, 40.0],
"set_flags": "",
"speaker": "",
