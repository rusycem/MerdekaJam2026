"node_name": &"_GraphNode_43432",
"position": [7020.0, 220.0],
"set_flags": "",
"speaker": "{player}",
"text": "“Maybe ask before accusing someone next time.”",
"type": "dialogue"
},
&"_GraphNode_43572": {
