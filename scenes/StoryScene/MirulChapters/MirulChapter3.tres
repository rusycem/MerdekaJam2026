},
&"@GraphNode@52445": {
"next_node": "@GraphNode@52462",
"node_name": &"@GraphNode@52445",
"position": [5480.0, 700.0],
"set_flags": "",
"speaker": "",
"text": "A thought have entered your mind...",
"type": "dialogue"
},
