"next_node": "@GraphNode@51940",
"node_name": &"@GraphNode@52462",
"position": [5820.0, 680.0],
"set_flags": "Flag_MirulWin",
"speaker": "",
"text": "\"Have you been a good friend?\"",
"type": "dialogue"
},
&"@GraphNode@52664": {
"next_node": "@GraphNode@52923",
"node_name": &"@GraphNode@52664",
"position": [4320.0, -100.0],
"set_flags": "",
"speaker": "Vihaan",
"text": "{Angry, Pose3}
\"Are you serious? I can't believe you're defending this right now.\"",
"type": "dialogue"
},
&"@GraphNode@52923": {
"next_node": "@GraphNode@52980",
"node_name": &"@GraphNode@52923",
"position": [4680.0, -80.0],
"set_flags": "",
"speaker": "{player}",
"text": "\"I'm sure he has his reason, I'm sticking with Mirul.\"",
