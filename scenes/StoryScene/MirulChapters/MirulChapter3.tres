"node_name": &"@GraphNode@60528",
"position": [16900.0, 980.0],
"set_flags": "",
"speaker": "",
"text": "The moment he realizes you told her, his expression changes. There is no point denying it anymore.",
"type": "dialogue"
},
&"@GraphNode@60578": {
"next_node": "@GraphNode@60823",
"node_name": &"@GraphNode@60578",
"position": [17240.0, 980.0],
"set_flags": "",
"speaker": "",
"text": "Mirul eventually confesses and is suspended.",
"type": "dialogue"
},
&"@GraphNode@60823": {
"next_node": "@GraphNode@60857",
"node_name": &"@GraphNode@60823",
"position": [17580.0, 980.0],
"set_flags": "",
"speaker": "",
"text": "Before he leaves, Mirul looks at you one last time. You can already tell what that look means.",
"type": "dialogue"
},
&"@GraphNode@60857": {
"next_node": "",
"node_name": &"@GraphNode@60857",
"position": [17920.0, 1020.0],
"set_flags": "",
"speaker": "",
"text": "He trusted you.",
"type": "dialogue"
},
