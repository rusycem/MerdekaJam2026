},
&"@GraphNode@58621": {
"next_node": "@GraphNode@58664",
"node_name": &"@GraphNode@58621",
"position": [17100.0, 280.0],
"set_flags": "",
"speaker": "",
"text": "Alyssa immediately protests, insisting that it is not hers and that someone must have planted it there. It does not matter. She is taken to the Principal’s office for questioning.",
"type": "dialogue"
},
&"@GraphNode@58664": {
"next_node": "@GraphNode@58767",
"node_name": &"@GraphNode@58664",
"position": [17440.0, 260.0],
"set_flags": "",
"speaker": "",
"text": "You look toward Mirul. He meets your eyes. That is enough. You understand exactly what happened.",
"type": "dialogue"
},
&"@GraphNode@58767": {
"next_node": "@GraphNode@58801",
"node_name": &"@GraphNode@58767",
"position": [17800.0, 260.0],
"set_flags": "",
"speaker": "",
"text": "You kept Vihaan quiet, and Mirul used that opportunity to frame her.",
"type": "dialogue"
},
&"@GraphNode@58801": {
"next_node": "@GraphNode@58835",
"node_name": &"@GraphNode@58801",
"position": [18180.0, 260.0],
"set_flags": "",
"speaker": "",
"text": "Alyssa is suspended from her Head Prefect duties while the school investigates.",
"type": "dialogue"
},
&"@GraphNode@58835": {
"next_node": "@GraphNode@58886",
"node_name": &"@GraphNode@58835",
"position": [18520.0, 260.0],
"set_flags": "",
"speaker": "",
"text": "Mirul gets away with it. And whether you meant to or not, you helped him.",
"type": "dialogue"
},
&"@GraphNode@58886": {
"next_node": "",
"node_name": &"@GraphNode@58886",
"position": [18880.0, 260.0],
"set_flags": "",
"speaker": "",
"text": "Even after getting what he wanted...Mirul still left unsatisfied.",
"type": "dialogue"
},
&"@GraphNode@58907": {
"next_node": "@GraphNode@59755",
"node_name": &"@GraphNode@58907",
"position": [16220.0, 1000.0],
"set_flags": "",
"speaker": "",
"text": "After school, you tell Alyssa the truth and confront Mirul together.",
"type": "dialogue"
},
