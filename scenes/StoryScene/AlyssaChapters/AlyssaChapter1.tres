"position": [2800,-250,],
},
&"A_Pass1": {
"type": "dialogue",
"speaker": "{player}",
"text": "{Angry, jump} Woi! Whoever hasn't submitted their homework, pass it here, cepat sikit!",
"next_node": "A_Pass2",
"position": [3150,-400,],
"set_flags": "",
},
&"A_Pass2": {
"type": "dialogue",
"speaker": "System",
"text": "A few students complain, but they eventually hand over their books.You return to ALYSSA with the stack.",
"next_node": "A_Pass3",
"position": [3500,-400,],
"set_flags": "",
},
&"A_Pass3": {
"type": "dialogue",
"speaker": "Alyssa",
"text": "{Happy_Pose1, nod} Not bad lah.",
"next_node": "A_Pass4",
"position": [3850,-400,],
"set_flags": "",
},
&"A_Pass4": {
"type": "dialogue",
"speaker": "{player}",
"text": "{Happy} Wah, is that a compliment?",
"next_node": "A_Pass5",
"position": [4200,-400,],
"set_flags": "",
},
&"A_Pass5": {
"type": "dialogue",
"speaker": "Alyssa",
"text": "{Annoyed_Pose1, shake} Pft, Perasan.",
