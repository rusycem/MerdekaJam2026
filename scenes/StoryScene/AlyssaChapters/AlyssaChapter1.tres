"set_flags": "",
},
&"A_Fail1": {
"type": "dialogue",
"speaker": "{player}",
"text": "{Neutral} Guys? Homework mana?",
"next_node": "A_Fail2",
"position": [3150,-150,],
"set_flags": "",
},
&"A_Fail2": {
"type": "dialogue",
"speaker": "System",
"text": "Nobody listens.You try again.ALYSSA sighs and steps forward.",
"next_node": "A_Fail3",
"position": [3500,-150,],
"set_flags": "",
},
&"A_Fail3": {
"type": "dialogue",
"speaker": "Alyssa",
"text": "{Angry_Pose2, jump} Walaoeh! Woi! Homework! Pass up now!",
