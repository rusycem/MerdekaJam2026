},
&"S2_11": {
"next_node": "S2_12",
"node_name": &"S2_11",
"position": [10600.0, 0.0],
"set_flags": "",
"speaker": "ANNOUNCEMENT",
"text": "\"The answer sheets for the upcoming final examinations have been reported missing.\"",
"type": "dialogue"
},
&"S2_12": {
"next_node": "S2_13",
"node_name": &"S2_12",
"position": [10950.0, 0.0],
"set_flags": "",
"speaker": "",
"text": "The class goes silent.",
