"next_node": "S2_14",
"node_name": &"S2_13",
"position": [11300.0, 0.0],
"set_flags": "",
"speaker": "ANNOUNCEMENT",
"text": "\"If anyone has information, please report to the Principal's office immediately.\"",
"type": "dialogue"
},
