graph_data = {
&"Start": {
"type": "actor",
"events": [{"action_type": "change_bg","background_uid": "res://assets/BGArtAssets/BG_Classroom.jpg",},{"action_type": "show_character","character": "Alyssa","expression": "Neutral_Pose1","position_slot": "Center","anim_duration": 0.5,"animation": "None",},],
"next_node": "D1",
"position": [0,0,],
},
&"D1": {
"type": "dialogue",
"speaker": "System",
"text": "Before class starts, ALYSSA is standing at the teacher's desk with a stack of attendance sheets.She looks busy.",
"next_node": "D2",
"position": [350,0,],
"set_flags": "",
},
&"D2": {
"type": "dialogue",
"speaker": "{player}",
"text": "{Neutral, nod} Wei, need help tak?",
"next_node": "D3",
"position": [700,0,],
"set_flags": "",
},
&"D3": {
"type": "dialogue",
"speaker": "System",
"text": "ALYSSA looks at you.",
"next_node": "D4",
"position": [1050,0,],
"set_flags": "",
},
&"D4": {
"type": "dialogue",
"speaker": "Alyssa",
"text": "{Neutral_Pose2, sigh} Haiya, ngam lah you asked. Half the class still haven't pass up their homework.",
"next_node": "D5",
"position": [1400,0,],
"set_flags": "",
},
&"D5": {
"type": "dialogue",
"speaker": "System",
"text": "She hands you a short list.",
"next_node": "D6",
"position": [1750,0,],
"set_flags": "",
},
&"D6": {
"type": "dialogue",
"speaker": "Alyssa",
"text": "{Neutral_Pose1} You help me collect, can ah?",
"next_node": "Choice1",
"position": [2100,0,],
"set_flags": "",
},
&"Choice1": {
"type": "choice_branch",
"prompt": "You glance around the classroom.Most students are already talking amongst themselves.",
"choices": Array[Dictionary]([{"text": "[PERSUASION — DC10] \"Oi, whoever hasn't submitted homework, pass it here.\"","condition": "","hide_if_locked": false,},{"text": "Help quietly.","condition": "","hide_if_locked": false,},]),
"next_nodes": ["Check1","B1",],
"position": [2450,0,],
},
&"Check1": {
"type": "dnd_check",
"target_stat": "Charm",
"dc_value": 10,
