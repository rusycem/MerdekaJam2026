"set_flags": "",
},
&"A_Fail4": {
"type": "dialogue",
"speaker": "System",
"text": "The class immediately starts moving.",
"next_node": "A_Fail5",
"position": [4200,-150,],
"set_flags": "",
},
&"A_Fail5": {
"type": "dialogue",
"speaker": "Alyssa",
"text": "{Annoyed_Pose3, sigh} You really need more confidence lah.",
