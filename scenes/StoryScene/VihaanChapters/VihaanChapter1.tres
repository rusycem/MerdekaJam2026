"position": [12340.0, 700.0],
"set_flags": "",
"speaker": "",
"text": "The afternoon study period is quiet. The teacher has given everyone some free time to work on their assignments. While studying, you notice Vihaan reading a novel.",
"type": "dialogue"
},
&"_GraphNode_30200": {
"next_node": "_GraphNode_30234",
"node_name": &"_GraphNode_30200",
"position": [12960.0, 680.0],
"set_flags": "",
"speaker": "{player}",
"text": "Aik you not studying? What novel is that?",
"type": "dialogue"
},
&"_GraphNode_30234": {
"next_node": "_GraphNode_30285",
"node_name": &"_GraphNode_30234",
"position": [13280.0, 700.0],
"set_flags": "",
"speaker": "Vihaan",
"text": "Science fiction.",
