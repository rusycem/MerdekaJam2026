},
&"_GraphNode_30439": {
"next_node": "_GraphNode_30470",
"node_name": &"_GraphNode_30439",
"position": [14560.0, 680.0],
"set_flags": "",
"speaker": "",
"text": "Vihaan surprisingly laughs. It's quiet, but still there.",
