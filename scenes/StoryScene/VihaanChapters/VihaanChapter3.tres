&"S2_F10": {
"next_node": "S2_F11",
"node_name": &"S2_F10",
"position": [10600.0, 0.0],
"set_flags": "",
"speaker": "",
"text": "Across the room, Mirul says nothing. Vihaan lowers his head. He knew the truth. He had the chance to speak. Now Alyssa is taking the blame.",
"type": "dialogue"
},
&"S2_F11": {
"next_node": "",
"node_name": &"S2_F11",
"position": [10950.0, 0.0],
"set_flags": "",
"speaker": "ENDING B - STAY SILENT",
"text": "Alyssa is suspended from her Head Prefect duties while the school investigates. Mirul avoids punishment. Vihaan is left knowing his silence allowed Mirul to frame someone else.",
"type": "dialogue"
},
&"S2_F2": {
"next_node": "S2_F3",
"node_name": &"S2_F2",
"position": [7800.0, 0.0],
"set_flags": "",
"speaker": "",
"text": "At the end of the day, Encik Samad enters with two teachers.",
"type": "dialogue"
},
&"S2_F3": {
"next_node": "S2_F4",
"node_name": &"S2_F3",
"position": [8150.0, 0.0],
"set_flags": "",
"speaker": "Principal",
"text": "{Angry, shake} Nobody leave. We're conducting a spot check now.",
"type": "dialogue"
},
&"S2_F4": {
"next_node": "S2_F5",
"node_name": &"S2_F4",
"position": [8500.0, 0.0],
"set_flags": "",
"speaker": "",
"text": "The teachers search each student's belongings. Eventually, they reach Alyssa. Encik Samad searches her bag. He pulls out a folded sheet. The stolen exam paper.",
"type": "dialogue"
},
&"S2_F5": {
"next_node": "S2_F6",
"node_name": &"S2_F5",
"position": [8850.0, 0.0],
"set_flags": "",
"speaker": "Alyssa",
"text": "{Angry_Pose1, jump} Hah?! That's not mine do!",
"type": "dialogue"
},
&"S2_F6": {
"next_node": "S2_F7",
"node_name": &"S2_F6",
"position": [9200.0, 0.0],
"set_flags": "",
"speaker": "Principal",
"text": "{Neutral, bounce} It was found in your bag, Alyssa.",
"type": "dialogue"
},
&"S2_F7": {
"next_node": "S2_F8",
"node_name": &"S2_F7",
"position": [9550.0, 0.0],
"set_flags": "",
"speaker": "Alyssa",
"text": "{Angry_Pose2, shake} Someone put it there lah!",
"type": "dialogue"
},
&"S2_F8": {
"next_node": "S2_F9",
"node_name": &"S2_F8",
"position": [9900.0, 0.0],
"set_flags": "",
"speaker": "",
"text": "She is taken to the Principal's office. You look at Vihaan. He looks horrified.",
"type": "dialogue"
},
&"S2_F9": {
"next_node": "S2_F10",
"node_name": &"S2_F9",
"position": [10250.0, 0.0],
"set_flags": "",
"speaker": "Vihaan",
"text": "{Shocked_Pose1, jump} ...Mirul.",
"type": "dialogue"
},
&"S2_T10": {
"next_node": "S2_T11",
"node_name": &"S2_T10",
"position": [10950.0, -450.0],
"set_flags": "",
"speaker": "Mirul",
"text": "{Angry_Pose3, shake} After everything, you're the one ratting me out ah?",
"type": "dialogue"
},
&"S2_T11": {
"next_node": "S2_T12",
"node_name": &"S2_T11",
"position": [11300.0, -450.0],
"set_flags": "",
"speaker": "Vihaan",
"text": "{Angry_Pose1, shake} I'm trying to stop you da!",
"type": "dialogue"
},
&"S2_T12": {
"next_node": "S2_T13",
"node_name": &"S2_T12",
"position": [11650.0, -450.0],
"set_flags": "",
"speaker": "Mirul",
"text": "{Angry_Pose4, shake} By getting me buang sekolah?!",
"type": "dialogue"
},
&"S2_T13": {
"next_node": "S2_T14",
"node_name": &"S2_T13",
"position": [12000.0, -450.0],
"set_flags": "",
"speaker": "Vihaan",
"text": "{Angry_Pose2, shake} By making you face what you actually did.",
"type": "dialogue"
},
&"S2_T14": {
"next_node": "S2_T15",
"node_name": &"S2_T14",
"position": [12350.0, -450.0],
"set_flags": "",
"speaker": "Alyssa",
"text": "{Angry_Pose2, jump} Why did you steal them do?",
"type": "dialogue"
},
&"S2_T15": {
"next_node": "S2_T16",
"node_name": &"S2_T15",
"position": [12700.0, -450.0],
"set_flags": "",
"speaker": "",
"text": "Mirul looks away.",
"type": "dialogue"
},
&"S2_T16": {
"next_node": "S2_T17",
"node_name": &"S2_T16",
"position": [13050.0, -450.0],
"set_flags": "",
"speaker": "Mirul",
"text": "{Sad_Pose1, sink} I wanted to prove the system is a joke lah.",
"type": "dialogue"
},
&"S2_T17": {
"next_node": "S2_T18",
"node_name": &"S2_T17",
"position": [13400.0, -450.0],
"set_flags": "",
"speaker": "Alyssa",
"text": "{Annoyed_Pose2, twitch} What does that even mean wei?",
"type": "dialogue"
},
&"S2_T18": {
"next_node": "S2_T19",
"node_name": &"S2_T18",
"position": [13750.0, -450.0],
"set_flags": "",
"speaker": "Mirul",
"text": "{Angry_Pose1, shake} You follow every rule. Vihaan study 24/7. My dad keeps comparing me to people like you guys.",
"type": "dialogue"
},
&"S2_T19": {
"next_node": "S2_T20",
"node_name": &"S2_T19",
"position": [14100.0, -450.0],
"set_flags": "",
"speaker": "",
"text": "He clenches his fist.",
"type": "dialogue"
},
&"S2_T2": {
"next_node": "S2_T3",
"node_name": &"S2_T2",
"position": [8150.0, -450.0],
"set_flags": "",
"speaker": "",
"text": "After the final bell, Alyssa approaches Mirul.",
"type": "dialogue"
},
&"S2_T20": {
"next_node": "S2_T21",
"node_name": &"S2_T20",
"position": [14450.0, -450.0],
"set_flags": "",
"speaker": "Mirul",
"text": "{Sad_Pose2, sink} I barely try and still pass mah. I wanted to prove how easy it was to beat the system.",
"type": "dialogue"
},
&"S2_T21": {
"next_node": "S2_T22",
"node_name": &"S2_T21",
"position": [14800.0, -450.0],
"set_flags": "",
"speaker": "Alyssa",
"text": "{Sad_Pose1, sink} And all you proved is that you're willing to hurt other people to do it lor.",
"type": "dialogue"
},
&"S2_T22": {
"next_node": "S2_T23",
"node_name": &"S2_T22",
"position": [15150.0, -450.0],
"set_flags": "",
"speaker": "System",
"text": "Mirul goes quiet. He looks at Vihaan one last time. Vihaan doesn't look away.",
"type": "dialogue"
},
&"S2_T23": {
"next_node": "EndFlagTrue",
"node_name": &"S2_T23",
"position": [15500.0, -450.0],
"set_flags": "",
"speaker": "ENDING A - VIHAAN SPEAKS UP",
"text": "Mirul is brought to Encik Samad and confesses. He is suspended, but not expelled. Vihaan loses much of Mirul's trust, but prevents him from making the situation worse.",
"type": "dialogue"
},
&"S2_T3": {
