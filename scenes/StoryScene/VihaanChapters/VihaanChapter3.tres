},
&"_GraphNode_78516": {
"next_node": "_GraphNode_85007",
"node_name": &"_GraphNode_78516",
"position": [11000.0, 420.0],
"set_flags": "",
"speaker": "",
"text": "Mirul has his fists clenched. He looks so disappointed in Vihaan, but Mirul couldn't bring himself to truly be mad. He knows Vihaan is trying to do the right thing.",
"type": "dialogue"
},
