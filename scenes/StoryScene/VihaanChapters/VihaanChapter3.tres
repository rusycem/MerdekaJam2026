"node_name": &"_GraphNode_78019",
"position": [13560.0, 400.0],
"set_flags": "",
"speaker": "ENDING [VIHAAN SPEAKS UP]",
"text": "Mirul is brought to Encik Samad and confesses. He is suspended, but not expelled. Vihaan loses much of Mirul’s trust, but prevents him from making the situation worse.",
